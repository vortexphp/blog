{% extends 'layouts/default.twig' %}
{% block content %}
{% set status = session_flash('status') %}
<div class="mx-auto max-w-3xl">
    <h1 class="text-3xl font-semibold tracking-tight text-zinc-900 dark:text-white sm:text-4xl">{{ title }}</h1>
    <p class="mt-3 flex flex-wrap gap-4 text-sm text-zinc-600 dark:text-zinc-400">
        <a href="/blog/manage" class="font-semibold text-emerald-600 transition hover:text-emerald-500 dark:text-emerald-400">{{ trans('blog.manage.categories.back_posts') }}</a>
        <a href="/blog" class="font-semibold text-emerald-600 transition hover:text-emerald-500 dark:text-emerald-400">{{ trans('blog.manage.view_blog') }}</a>
    </p>

    {% if status is string and status != '' %}
        <p class="mt-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900 dark:border-emerald-900/40 dark:bg-emerald-950/40 dark:text-emerald-200">{{ status }}</p>
    {% endif %}

    <p class="mt-8">
        <a href="/blog/manage/categories/new" class="inline-flex rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-emerald-600/20 transition hover:bg-emerald-500">{{ trans('blog.manage.categories.new') }}</a>
    </p>

    {% if categories is empty %}
        <p class="mt-12 rounded-2xl border border-dashed border-zinc-300 bg-zinc-50/80 px-6 py-12 text-center text-zinc-600 dark:border-zinc-700 dark:bg-zinc-900/40 dark:text-zinc-400">{{ trans('blog.manage.categories.empty') }}</p>
    {% else %}
        <ul class="mt-8 space-y-3">
            {% for c in categories %}
                {% set cid = c.id|default(0) %}
                {% set cname = c.name|default('') %}
                {% set cslug = c.slug|default('') %}
                <li class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-zinc-200/90 bg-white/90 px-5 py-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900/60">
                    <div class="min-w-0">
                        <span class="font-semibold text-zinc-900 dark:text-white">{{ cname }}</span>
                        <span class="mt-1 block truncate font-mono text-xs text-zinc-500 dark:text-zinc-500">/blog/category/{{ cslug|url_encode }}</span>
                    </div>
                    <div class="flex flex-wrap items-center gap-3 text-sm">
                        <a href="/blog/manage/categories/{{ cid }}/edit" class="font-semibold text-emerald-600 transition hover:text-emerald-500 dark:text-emerald-400">{{ trans('blog.manage.categories.edit') }}</a>
                        <form method="post" action="/blog/manage/categories/{{ cid }}/delete" class="inline" onsubmit="return confirm('{{ trans('blog.manage.categories.delete_confirm')|e('js') }}');">
                            <input type="hidden" name="_csrf" value="{{ csrfToken|default('') }}">
                            <button type="submit" class="cursor-pointer font-medium text-red-600 transition hover:text-red-500 dark:text-red-400">{{ trans('blog.manage.categories.delete') }}</button>
                        </form>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
{% endblock %}
